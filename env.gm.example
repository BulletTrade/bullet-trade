# 掘金环境准备配置。复制为 .env.gm 后填写，该私密文件由 .gitignore 排除。
# 已注册 gm 数据源和本地 Broker 候选版；GM Server 尚未实现。
DEFAULT_DATA_PROVIDER=gm
# 运行数据仅来自 GM；聚宽只用于开发测试的独立对比，不需要聚宽配置。
GM_DATA_TIMEOUT=30
# SDK 已在另一解释器中安装时指定绝对路径；默认使用当前 Python。
GM_PYTHON_EXECUTABLE=
GM_LIVE_MAX_AGE_SECONDS=5
# GM_TOKEN 是用户身份密钥，不是资金账户密码。
GM_TOKEN=
# gm.api 实时会话使用的策略 ID；与资金账户 ID 不同。
GM_STRATEGY_ID=
# 必须明确选择的掘金资金账户 ID；不用默认账户替代。
GM_ACCOUNT_ID=
# 留空使用 SDK 默认本机终端地址；显式地址须以目标终端配置为准。
GM_SERV_ADDR=

# 本地交易配置：确认账户与授权后才启用交易。
DEFAULT_BROKER=gm
GM_ENABLE_TRADING=false
GM_TRADE_TIMEOUT=20
# 必填，固定保存该账户的委托恢复记录；不得通过换路径重试未知订单。
GM_JOURNAL_PATH=
